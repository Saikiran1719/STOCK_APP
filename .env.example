# Copy this file to .env.local and fill in real values for local development.
# In production, set the same keys in the Vercel project's Environment Variables.

# --- Supabase ---
# Project URL and service role key, from Supabase project Settings -> API.
# The service role key bypasses Row Level Security — it's only ever read
# server-side (in API routes), never sent to the browser.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- App access ---
# Shared password clients enter to use the app.
APP_PASSWORD=change-me
# Random string (32+ chars) used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
